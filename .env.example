# Massive / Polygon.io-compatible API key. Free stock plans are commonly limited to 5 requests/minute.
MASSIVE_API_KEY=
MASSIVE_RPM=5

# Alpaca Trading API key pair, used only for batch historical market-data requests.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Free accounts use IEX. Set sip only when the Alpaca account has SIP historical-data entitlement.
ALPACA_FEED=iex

# SEC fair-access identity. Include an application name and monitored contact email.
SEC_USER_AGENT=USMarketCloseReport/2.0 your-email@example.com
SEC_RPS=5
