# Live mode: Massive is used only for two grouped-daily snapshots and one batched short-interest request.
MASSIVE_API_KEY=
MASSIVE_RPM=5

# Live mode: Alpaca supplies six-month histories for all selected movers in batches.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex

# SEC requests must identify the operator. Example:
SEC_USER_AGENT=USMarketCloseReport/2.0 your-email@example.com
SEC_RPS=5

# AI translation. auto prefers Gemini, then a configured Ollama endpoint, then Argos fallback.
TRANSLATION_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RPM=10

# Optional alternative: remote/self-hosted Ollama API. Do not run Gemma 4 locally on a standard GitHub-hosted runner.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4
OLLAMA_RPM=20
