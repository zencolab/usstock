# Live mode: Massive is used only for two grouped-daily snapshots and one batched short-interest request.
MASSIVE_API_KEY=
MASSIVE_RPM=5

# Live mode: Alpaca supplies six-month histories and the complete three-month news catalog.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex
ALPACA_NEWS_RPM=180
ALPACA_NEWS_MAX_PAGES=100

# SEC requests must identify the operator. Example:
SEC_USER_AGENT=USMarketCloseReport/4.0 your-email@example.com
SEC_RPS=5

# Ollama translates industries plus every news title and available summary.
TRANSLATION_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=
# Optional authorized fallback credential, tried only after 401/402/403/429.
OLLAMA_API_KEY_FALLBACK=
OLLAMA_MODEL=gemma4:cloud
OLLAMA_RPM=20
