# The report reuses the root project's Massive, Alpaca, SEC and Ollama settings.
# Copy the root .env.example values when running locally.

# Optional: override the official iShares IWM holdings CSV endpoint.
RUSSELL2000_HOLDINGS_URL=

# Optional: use an authorized local CSV/text constituent snapshot instead of IWM holdings.
# The file must contain 1,500-2,500 valid tickers.
RUSSELL2000_CONSTITUENTS_FILE=
RUSSELL2000_MIN_CONSTITUENTS=1500
RUSSELL2000_MAX_CONSTITUENTS=2500

# Optional Drive gateway operation. The workflow otherwise reuses DRIVE_MARKET_REPORT_OPERATION.
RUSSELL2000_DRIVE_OPERATION=
